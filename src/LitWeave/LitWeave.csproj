<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LitWeave</AssemblyName>
    <RootNamespace>LitWeave</RootNamespace>
    <ApplicationIcon>Assets\litweave.ico</ApplicationIcon>
    <Version>0.2.1-beta.1</Version>
    <Authors>Frank Lai</Authors>
    <Description>Visual Literature Mapping for Zotero</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\litweave.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\web\dist\**\*"
                      LogicalName="LitWeave.Web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
